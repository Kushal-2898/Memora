rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Memora user-scoped data: users can only read and write their own documents and subcollections
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
